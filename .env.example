# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored and must never be committed — the repository is public (D19).
#
# Every key here is validated in `lib/env.ts`. Adding a key to one without the
# other is a bug: the schema is what makes a missing variable fail the build.

# Absolute origin of the running app, no trailing slash.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Not yet in use -----------------------------------------------------------
# Added to lib/env.ts by the task that introduces them, not before.
#
# DATABASE_URL          P0-16 — Neon Postgres. Use the POOLED connection string,
#                       never the direct one (D20).
# Payment provider keys P4-01 — blocked on D1.
# Email provider key    P4-08.
# Auth secret           P4-07 — blocked on D4.
